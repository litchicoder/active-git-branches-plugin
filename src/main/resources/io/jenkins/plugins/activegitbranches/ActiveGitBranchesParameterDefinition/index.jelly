<?jelly escape-by-default='true'?>
<j:jelly xmlns:j="jelly:core" xmlns:st="jelly:stapler" xmlns:d="jelly:define" 
         xmlns:l="/lib/layout" xmlns:t="/lib/hudson" xmlns:f="/lib/form">

    <st:adjunct includes="io.jenkins.plugins.activegitbranches.ActiveGitBranchesParameterDefinition.index" />

    <f:entry title="${it.name}" description="${it.description}">
        <div name="parameter" class="active-git-branches-parameter" data-agb-name="${it.name}">
            <input type="hidden" name="name" value="${it.name}" />
            <j:set var="branches" value="${it.fetchBranches()}" />
            <j:set var="fetchedAgo" value="${it.cacheFetchedAgoText}" />
            <j:set var="lastRefreshFailed" value="${it.lastRefreshFailed}" />
            <j:set var="effectiveDefault" value="${it.effectiveDefaultValue}" />
            <j:choose>
                <j:when test="${empty(branches) and !it.allowCustomBranch}">
                    <select name="value" class="setting-input" disabled="disabled">
                        <option value="">-- No branches available --</option>
                    </select>
                    <div class="error">Unable to fetch branches from repository. Please check the configuration.</div>
                </j:when>
                <j:otherwise>
                    <select name="value" class="setting-input agb-select">
                        <j:forEach var="branch" items="${branches}">
                            <j:choose>
                                <j:when test="${branch.disabled}">
                                    <option value="${branch.name}" disabled="disabled" class="agb-disabled-option">${branch.name} (disabled)</option>
                                </j:when>
                                <j:when test="${branch.name == effectiveDefault}">
                                    <option value="${branch.name}" selected="selected">${branch.name}</option>
                                </j:when>
                                <j:otherwise>
                                    <option value="${branch.name}">${branch.name}</option>
                                </j:otherwise>
                            </j:choose>
                        </j:forEach>
                        <j:if test="${it.allowCustomBranch}">
                            <option disabled="disabled">──────────</option>
                            <option value="__custom__">✏ Custom (manual input)...</option>
                        </j:if>
                    </select>
                    <j:if test="${it.allowCustomBranch}">
                        <div class="agb-custom-wrapper">
                            <input type="text" name="customValue" class="setting-input agb-custom-input"
                                   placeholder="Enter branch name (e.g. feature/my-branch)"
                                   autocomplete="off" disabled="disabled" />
                            <div class="agb-custom-hint">
                                Manual input bypasses the branch filter. Whitespace and characters like ~ ^ : ? * [ \\ are rejected.
                            </div>
                        </div>
                    </j:if>
                    <j:if test="${fetchedAgo != null}">
                        <div class="agb-cache-meta">
                            <span>fetched ${fetchedAgo}</span>
                            <j:if test="${lastRefreshFailed}">
                                <span class="agb-refresh-warning" title="The most recent background refresh failed; the list above may be stale.">
                                    · ⚠ last refresh failed
                                </span>
                            </j:if>
                            <span>·</span>
                            <span>reload page to refresh</span>
                        </div>
                    </j:if>
                </j:otherwise>
            </j:choose>
        </div>
    </f:entry>

</j:jelly>
